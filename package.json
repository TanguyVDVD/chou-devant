{
  "name": "chou-devant",
  "version": "1.0.0",
  "description": "Chou Devant ! Un jeu d'empilement de pâtisseries à 2-4 joueurs, en temps réel.",
  "private": true,
  "main": "dist/server/index.js",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsc -p tsconfig.server.json && node dist/server/index.js",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/partie.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@fontsource/bagel-fat-one": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "matter-js": "^0.20.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
